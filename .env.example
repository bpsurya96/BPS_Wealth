# =============================================================================
# BPS Income & Investment Tracker - Open-Source AI & App Environment
# Copy this file to .env.local and customize as needed.
# =============================================================================

# --- Database & Document Storage ---
BPS_DB_PATH=./data/bps_income.db
BPS_DOCS_DIR=./data/documents

# --- Security ---
BPS_PIN_SECRET=change-this-to-a-random-local-secret

# --- Open-Source AI Configuration (100% Local / Self-Hosted) ---
# Provider options: "ollama" | "oss_openai" | "local"
# - ollama     : Local Ollama server (recommended)
# - oss_openai : Any OpenAI-compatible open-source server (vLLM, LM Studio, LocalAI)
# - local      : Deterministic offline copilot (no LLM server needed)
AI_PROVIDER=ollama

# --- Ollama Settings (http://localhost:11434) ---
OLLAMA_BASE_URL=http://localhost:11434
# Planning, Q&A, and financial reasoning model (e.g. qwen2.5:7b, deepseek-r1:8b, llama3.2)
OLLAMA_CHAT_MODEL=qwen2.5:7b
# Deep financial planning model (defaults to OLLAMA_CHAT_MODEL if empty)
OLLAMA_PLANNING_MODEL=deepseek-r1:8b
# Vision model for image / screenshot / insurance policy extraction (e.g. qwen2.5vl:7b, llama3.2-vision)
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# Embedding model for document/data search (already installed: qwen3-embedding:0.6b)
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# --- Optional: Open-Source OpenAI-Compatible Endpoint (vLLM / LM Studio / LocalAI) ---
OSS_OPENAI_BASE_URL=http://localhost:8000/v1
OSS_OPENAI_API_KEY=local-oss-token
OSS_OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct
OSS_OPENAI_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
