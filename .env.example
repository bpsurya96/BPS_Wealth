# =============================================================================
# BPS Wealth - Environment Configuration Template
# Copy to .env.local (dev) or .env (production) and populate real secrets.
# NEVER commit .env or .env.local to version control.
# =============================================================================

# --- Database & Document Storage (must be on persistent volume in production) ---
BPS_DB_PATH=./data/bps_income.db
BPS_DOCS_DIR=./data/documents
BPS_BACKUPS_DIR=./data/backups
BPS_MAX_BACKUPS=15

# --- Security & Authentication (MANDATORY IN PRODUCTION) ---
# Generate with: openssl rand -hex 32
BPS_PIN_SECRET=
# First-run owner bootstrap token (min 16 chars). Required until initial PIN is set.
# If omitted, the server generates a one-time token into ./data/.owner-setup-token (0600).
BPS_OWNER_SETUP_TOKEN=
# Set to "true" when served behind HTTPS reverse proxy (default: true in production)
BPS_COOKIE_SECURE=true
# Session expiration in hours (1 - 168)
BPS_SESSION_TTL_HOURS=12
# Optional: enforce PIN gate in local development too
BPS_REQUIRE_AUTH_IN_DEV=false
# Optional: explicit public origin for CSRF validation (e.g. https://wealth.example.com)
APP_ORIGIN=

# --- SQL Studio Security ---
# In production, SQL Studio always runs on an isolated read-only SQLite connection.
SQL_STUDIO_ENABLED=true
# Ignored in production (writes are permanently disabled in production).
SQL_STUDIO_ALLOW_WRITES=false

# --- AI Configuration (Local Ollama Recommended) ---
# Provider options: "ollama" | "oss_openai" | "local"
AI_PROVIDER=ollama
AI_TIMEOUT_MS=120000

# --- Ollama Settings (Keep Private; Never Expose Port 11434 Publicly) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_PLANNING_MODEL=deepseek-r1:8b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# --- Optional: OpenAI-Compatible Endpoint ---
OSS_OPENAI_BASE_URL=http://localhost:8000/v1
OSS_OPENAI_API_KEY=
OSS_OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct
OSS_OPENAI_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
